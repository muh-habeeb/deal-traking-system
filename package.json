{
  "name": "swoop",
  "version": "1.0.0",
  "description": "Deal tracking backend with Facebook Marketplace scraping",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "worker": "node src/workers/queueWorker.js",
    "worker:dev": "nodemon src/workers/queueWorker.js",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:down:volumes": "docker compose down -v",
    "docker:logs": "docker compose logs -f app",
    "docker:ps": "docker compose ps",
    "docker:migrate": "docker compose exec app npm run prisma:deploy",
    "auth:facebook": "node src/scripts/saveFacebookAuthState.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "chalk": "^4.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.5.0"
  }
}
