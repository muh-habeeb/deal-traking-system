NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deals_db?schema=public"
DB_CONNECT_TIMEOUT_SECONDS=6
DB_IDLE_TIMEOUT_SECONDS=30
DB_QUERY_TIMEOUT_SECONDS=12
DB_POOL_MAX=10
# Legacy cron setting (not used by queue worker):
# SCRAPE_CRON=*/10 * * * *

MAX_LISTINGS_PER_FILTER=25
WORKER_ID=0
START_QUEUE_WORKER_IN_SERVER=true
SYNC_QUEUE_ON_BOOT=true
WORKER_IDLE_SLEEP_SECONDS=1
WORKER_ERROR_RETRY_SECONDS=45
WORKER_RESTART_DELAY_SECONDS=10
WORKER_STALE_LOCK_SECONDS=300
CLEANUP_EVERY_JOBS=10

PROXY_ENABLED=false
PROXY_LIST_PATH=data/proxies.json
PROXY_ROTATE_ON_FAILURE=true
PROXY_MAX_FAILOVER_ATTEMPTS=3
PROXY_BIND_SESSION_TO_PROXY=true

SCAN_TIMEZONE=America/Toronto
MORNING_PEAK_START_HOUR=7
MORNING_PEAK_END_HOUR=10
EVENING_PEAK_START_HOUR=17
EVENING_PEAK_END_HOUR=22

HIGH_PEAK_DELAY_SECONDS=30
HIGH_OFFPEAK_DELAY_SECONDS=60
MEDIUM_PEAK_DELAY_SECONDS=45
MEDIUM_OFFPEAK_DELAY_SECONDS=120
LOW_PEAK_DELAY_SECONDS=120
LOW_OFFPEAK_DELAY_SECONDS=300

LISTING_LOOKBACK_MINUTES=5
LISTING_LOOKBACK_HOURS=24
REQUIRE_POSTED_TIME=false
LISTING_RETENTION_HOURS=24
NOTIFICATION_RETENTION_HOURS=12
NOTIFICATION_DELAY_SECONDS=2.5
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_LOCALE=en-CA
PLAYWRIGHT_TIMEZONE=America/Toronto
PLAYWRIGHT_SESSION_DIR=playwright/sessions
PLAYWRIGHT_SESSION_PREFIX=session_
PLAYWRIGHT_BASE_URL=https://www.facebook.com/marketplace
PLAYWRIGHT_STORAGE_STATE_PATH=playwright/storageState.json
PLAYWRIGHT_EXECUTABLE_PATH=""
PLAYWRIGHT_BROWSER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage
ALLOW_REMOTE_FACEBOOK_LOGIN=false
DISPLAY=:99
XVFB_SCREEN=1366x768x24
VNC_PORT=5900
NOVNC_PORT=6080
NO_VNC_PUBLIC_URL=
VNC_PASSWORD=change-this-vnc-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
ALERT_FROM="Deal Tracker <you@example.com>"
ALERT_TO=you@example.com

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT_SECONDS=15
TELEGRAM_REQUEST_RETRIES=2
TELEGRAM_BATCH_WINDOW_SECONDS=10
TELEGRAM_BATCH_MAX_SIZE=3

APP_AUTH_SECRET=change-this-long-secret

# this will be master app credentials 
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=admin123
NODE_OPTIONS=--dns-result-order=ipv4first
CORS_ORIGIN=
