NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deals_db?schema=public"
SCRAPE_CRON=*/10 * * * *
RUN_SCAN_ON_BOOT=true
MAX_LISTINGS_PER_FILTER=30
LISTING_RETENTION_HOURS=24
NOTIFICATION_RETENTION_HOURS=12
NOTIFICATION_DELAY_MS=2500
PLAYWRIGHT_HEADLESS=true
ALLOW_REMOTE_FACEBOOK_LOGIN=false
PLAYWRIGHT_BASE_URL=https://www.facebook.com/marketplace
PLAYWRIGHT_STORAGE_STATE_PATH=playwright/storageState.json
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
ALERT_FROM="Deal Tracker <you@example.com>"
ALERT_TO=you@example.com
APP_AUTH_SECRET=change-this-long-secret
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=admin123


NODE_OPTIONS=--dns-result-order=ipv4first